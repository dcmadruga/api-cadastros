# Conexão com o PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
# Banco que a API usa no dia a dia
DB_NAME=api_db
# Area separada dentro do banco para as tabelas da API (nao mexe em tabelas de outros sistemas)
DB_SCHEMA=api_cadastros
# Banco usado SOMENTE pelos testes (é apagado e recriado; precisa terminar com _test)
DB_TEST_NAME=api_test
API_HOST=127.0.0.1
API_PORT=8000
